{
  "manifest_version": 3,
  "name": "CodeReview - 代码知识收藏",
  "version": "1.0.0",
  "description": "在浏览网页时，一键将选中的代码或文字保存到 CodeReview 知识库",
  "permissions": ["contextMenus", "storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
